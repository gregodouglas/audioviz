{
  "id": "comet",
  "name": "Comet",
  "short": "Comet",
  "summary": "Bright heads tracing looping paths with the music, leaving trails that drift outward and fade.",
  "credit": "Example 3 of docs/building-visuals.md.",
  "hint": "Each head moves on the music clock, so the figure races when the music is loud. Its trail is last frame's picture, moved a little and faded.",
  "feedback": true,
  "params": [
    { "id": "heads", "label": "Heads", "type": "integer", "group": "Path", "min": 1, "max": 6, "default": 3 },
    { "id": "figure", "label": "Figure", "type": "choice", "group": "Path", "options": ["Circle", "Eight", "Knot"], "default": "knot" },
    { "id": "radius", "label": "Radius", "group": "Path", "min": 0.1, "max": 1.2, "default": 0.6 },
    { "id": "speed", "label": "Speed", "group": "Path", "min": 0.05, "max": 2.0, "default": 0.5, "log": true },
    { "id": "size", "label": "Head size", "group": "Light", "min": 1.0, "max": 30.0, "default": 6.0, "unit": "px" },
    { "id": "trail", "label": "Trail", "group": "Trail", "min": 0.05, "max": 4.0, "default": 0.8, "log": true, "unit": "s", "help": "How long the trail takes to fade to a third." },
    { "id": "drift", "label": "Drift", "group": "Trail", "min": 0.0, "max": 1.0, "default": 0.15, "help": "How fast the trail moves outward." },
    { "id": "swirl", "label": "Swirl", "group": "Trail", "min": -1.0, "max": 1.0, "default": 0.1, "help": "How fast the trail turns." }
  ]
}
