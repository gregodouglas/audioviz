    { "id": "count", "label": "Count", "type": "integer", "group": "Shards", "min": 1, "max": 16, "default": 6 },
    { "id": "size", "label": "Size", "group": "Shards", "min": 0.2, "max": 3.0, "default": 0.9 },
    { "id": "stretch", "label": "Stretch", "group": "Shards", "min": 0.3, "max": 4.0, "default": 1.6 },
    { "id": "spin", "label": "Tumble", "group": "Shards", "min": 0.0, "max": 4.0, "default": 1.0 },
    { "id": "scatter", "label": "Scatter", "group": "Shards", "min": 0.0, "max": 1.0, "default": 0.0, "help": "How far the shards fly apart and back over each bar." },
    { "id": "every", "label": "New pose every", "type": "integer", "group": "Shards", "min": 1, "max": 8, "default": 1, "unit": "beats" },
    { "id": "facets", "label": "Facets", "group": "Look", "min": 0.0, "max": 3.0, "default": 2.2 },
    { "id": "edges", "label": "Edges", "group": "Look", "min": 0.0, "max": 3.0, "default": 0.0 },
    { "id": "width", "label": "Edge width", "group": "Look", "min": 0.5, "max": 6.0, "default": 1.5, "unit": "px" },
    { "id": "react", "label": "Reacts", "group": "Look", "min": 0.0, "max": 3.0, "default": 1.0 }
