{
  "id": "scope",
  "name": "Phosphor scope",
  "short": "Scope",
  "summary": "The waveform drawn as a glowing phosphor beam (left and right channels as X and Y). Lines, cheap.",
  "credit": "",
  "hint": "With a palette (Colour tab): the key picks the colour and fast travel moves along it, or each part of the trace takes the colour of its own pitch, bass at the start of the palette and treble at the end.",
  "feedback": true,
  "band_waveform": true,
  "items": 1,
  "line": 4096,
  "line_style": "beam",
  "params": [
    { "id": "gain", "label": "Gain", "group": "Beam", "min": 0.05, "max": 3.0, "default": 0.85, "log": true },
    { "id": "auto_gain", "label": "Auto gain", "type": "toggle", "group": "Beam", "default": true },
    { "id": "beam_width", "label": "Beam width", "group": "Beam", "min": 0.3, "max": 6.0, "default": 1.2, "unit": "px" },
    { "id": "beam_intensity", "label": "Beam intensity", "group": "Beam", "min": 0.05, "max": 20.0, "default": 1.0, "log": true },
    { "id": "rotation_deg", "label": "Rotation", "group": "Trace", "min": -180.0, "max": 180.0, "default": 45.0, "unit": "°" },
    { "id": "persistence", "label": "Persistence", "group": "Trace", "min": 0.0001, "max": 0.9, "default": 0.05, "log": true, "help": "How much of the trace is left after one second." },
    { "id": "beat_pulse", "label": "Beat pulse", "group": "Trace", "min": 0.0, "max": 1.0, "default": 0.3 },
    { "id": "colour", "label": "Palette by", "type": "choice", "group": "Colour", "options": ["Key and speed", "Frequency"], "values": ["key", "frequency"], "default": "key" }
  ]
}
